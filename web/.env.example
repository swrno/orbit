# /web/.env.example
# Copy this file to .env and fill in your actual values

# ===========================================
# Tambo AI Configuration
# ===========================================
NEXT_PUBLIC_TAMBO_API_KEY=your_tambo_api_key_here

# ===========================================
# MongoDB Configuration
# ===========================================
# Local MongoDB: mongodb://localhost:27017/orbit
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGODB_URI=mongodb://localhost:27017/orbit

# ===========================================
# Firebase Client SDK (Public - Browser)
# ===========================================
# Get these from Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# ===========================================
# Firebase Admin SDK (Private - Server Only)
# ===========================================
# Get these from Firebase Console > Project Settings > Service Accounts
# Generate new private key and download JSON file
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# Important: Keep quotes around the private key value
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nPrivate\nKey\nHere\n-----END PRIVATE KEY-----\n"

# ===========================================
# Application Configuration
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
